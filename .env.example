# URL pública da loja (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chamadas feitas pelo servidor Next.js → API (páginas públicas renderizadas no servidor)
API_INTERNAL_URL=http://localhost:5001
# Chamadas do navegador → API (carrinho, checkout, conta, admin)
NEXT_PUBLIC_API_URL=http://localhost:5001
# Segredo enviado no header X-Internal-Key nas chamadas do servidor (mesmo valor de RateLimiting:InternalKey da API)
API_INTERNAL_KEY=dev-internal-key

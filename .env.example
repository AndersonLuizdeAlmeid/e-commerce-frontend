# URL pública da loja (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chamadas feitas pelo servidor Next.js → API (páginas públicas renderizadas no servidor)
API_INTERNAL_URL=http://localhost:5001
# Chamadas do navegador → API (carrinho, checkout, conta, admin)
NEXT_PUBLIC_API_URL=http://localhost:5001
# Segredo enviado no header X-Internal-Key nas chamadas do servidor (mesmo valor de RateLimiting:InternalKey da API)
API_INTERNAL_KEY=dev-internal-key
# WhatsApp da loja para o botão "Falar com a MO" (só dígitos, com DDI e DDD). Sem valor, usa o número do Instagram da loja
NEXT_PUBLIC_WHATSAPP_NUMBER=5551997553649
# Segredo da revalidação sob demanda (/api/revalidate), o mesmo de Storefront:RevalidateSecret na API
REVALIDATE_SECRET=dev-revalidate-secret
# Base pública das fotos enviadas pelo painel (a mesma de ImageStorage:PublicBaseUrl na API). Lida no build
NEXT_PUBLIC_IMAGES_URL=http://localhost:9000/mo-images
# Chave pública do Mercado Pago (TEST-... no sandbox). Lida em tempo de execução, não no build. Sem valor, o cartão
# só aparece como cartão de teste, e só quando a API usa a plataforma falsa
MERCADOPAGO_PUBLIC_KEY=

{
  "name": "e-commerce-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript http://localhost:5001/openapi/v1.json -o src/shared/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:build": "node scripts/e2e-build.mjs",
    "e2e:images": "docker build --target api -t mo-e2e-api:local ../e-commerce-backend && docker build --target migrator -t mo-e2e-migrator:local ../e-commerce-backend",
    "e2e:stack": "docker compose -f e2e/compose.yml up -d",
    "e2e:down": "docker compose -f e2e/compose.yml down"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.90.5",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.65.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "playwright-core": "1.65.0"
  }
}
